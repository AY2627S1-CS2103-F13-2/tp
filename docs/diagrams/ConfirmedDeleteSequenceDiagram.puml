@startuml
!include style.puml
skinparam ArrowFontStyle plain
mainframe **sd** run confirmed delete

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "c:ConfirmationRequest" as ConfirmationRequest LOGIC_COLOR
participant "cd:ConfirmedDeleteCommand" as ConfirmedDeleteCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

activate LogicManager
LogicManager -> ConfirmationRequest : respond("y", m)
activate ConfirmationRequest

ConfirmationRequest -> ConfirmedDeleteCommand : execute(m)
activate ConfirmedDeleteCommand

ConfirmedDeleteCommand -> Model : deletePerson(p)
activate Model
Model --> ConfirmedDeleteCommand
deactivate Model

ConfirmedDeleteCommand -> Model : updateFilteredPersonList(all)
activate Model
Model --> ConfirmedDeleteCommand
deactivate Model

ConfirmedDeleteCommand --> ConfirmationRequest : result
deactivate ConfirmedDeleteCommand

ConfirmationRequest --> LogicManager : result
deactivate ConfirmationRequest
deactivate LogicManager
@enduml
