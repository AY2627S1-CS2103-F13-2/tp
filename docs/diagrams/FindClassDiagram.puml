@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package "Find logic" {
    Class FindCommandParser
    Class FindCommand
    Class "Predicate<Person>" as PersonPredicate
    Class NameContainsKeywordsPredicate
    Class FuzzyNamePredicate
    Class ContactFieldPredicate
    Class EventContainsKeywordsPredicate
}

package Model {
    Class Person
    Class Model
}

FindCommandParser ..> FindCommand : <<create>>
FindCommand --> PersonPredicate : stores
PersonPredicate <|.. NameContainsKeywordsPredicate
PersonPredicate <|.. FuzzyNamePredicate
PersonPredicate <|.. ContactFieldPredicate
PersonPredicate <|.. EventContainsKeywordsPredicate

FindCommand ..> Model : updates filtered list
PersonPredicate ..> Person : tests
@enduml
