@startuml
!include style.puml
skinparam ArrowFontStyle plain
mainframe **sd** create delete confirmation c

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "cd:ConfirmedDeleteCommand" as ConfirmedDeleteCommand LOGIC_COLOR
participant "c:ConfirmationRequest" as ConfirmationRequest LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

activate LogicManager
LogicManager -> DeleteCommand : execute(m)
activate DeleteCommand

DeleteCommand -> Model : getFilteredPersonList()
activate Model
Model --> DeleteCommand : displayed contacts
deactivate Model

create ConfirmedDeleteCommand
DeleteCommand -> ConfirmedDeleteCommand : ConfirmedDeleteCommand(targets)
activate ConfirmedDeleteCommand
ConfirmedDeleteCommand --> DeleteCommand
deactivate ConfirmedDeleteCommand

create ConfirmationRequest
DeleteCommand -> ConfirmationRequest : ConfirmationRequest(preview, cd)
activate ConfirmationRequest
ConfirmationRequest --> DeleteCommand
deactivate ConfirmationRequest

DeleteCommand --> LogicManager : result carrying c
deactivate DeleteCommand
deactivate LogicManager
@enduml
