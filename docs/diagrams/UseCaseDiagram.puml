@startuml
!include style.puml

left to right direction
skinparam linetype ortho

actor User as user

rectangle Astra {
    package "Contact management" {
        usecase "UC01\nAdd contact" as UC01
        usecase "UC02\nDelete contact" as UC02
        usecase "UC03\nFind or view contact" as UC03
        usecase "UC04\nEdit contact" as UC04
        usecase "UC05\nClear contacts" as UC05
        usecase "UC06\nStart Astra and restore saved contacts" as UC06
    }

    package "Interaction and follow-up" {
        usecase "UC11\nEdit logged interaction" as UC11
        usecase "UC12\nReview follow-ups" as UC12
        usecase "UC16\nRecord follow-up" as UC16
        usecase "UC17\nComplete or reopen follow-up" as UC17
        usecase "UC21\nStar and retrieve important contacts" as UC21
    }

    package "Filtering and display" {
        usecase "UC20\nFilter contacts by tags" as UC20
        usecase "UC26\nReorder displayed contact information" as UC26
    }
}

user --> UC01
user --> UC02
user --> UC03
user --> UC04
user --> UC05
user --> UC06
user --> UC11
user --> UC12
user --> UC16
user --> UC17
user --> UC20
user --> UC21
user --> UC26

@enduml
