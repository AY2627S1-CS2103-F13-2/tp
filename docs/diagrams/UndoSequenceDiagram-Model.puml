@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedContactFile" as VersionedContactFile MODEL_COLOR
end box

[-> Model : undoContactFile()
activate Model

Model -> VersionedContactFile : undo()
activate VersionedContactFile

VersionedContactFile -> VersionedContactFile :resetData(ReadOnlyContactFile)
VersionedContactFile --> Model :
deactivate VersionedContactFile

[<-- Model
deactivate Model

@enduml
