<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="followUpListPanel" spacing="12"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <Label fx:id="followUpHeading" styleClass="followup-heading" />
  <ListView fx:id="followUpListView" VBox.vgrow="ALWAYS" />
  <Label text="Select a row or enter its number. Use list to return to contacts."
         wrapText="true" styleClass="followup-hint" />
</VBox>
